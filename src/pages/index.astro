---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Orbit — a browser instrument"
  description="Orbit is a browser instrument: touch, click, or drag the glowing core to play it — no tutorial, no score, just a small gravity field that sounds like what you do to it."
>
  <h1 class="visually-quiet">Orbit</h1>
  <div id="orbit-space" class="orbit-space">
    <canvas id="orbit-canvas" class="orbit-canvas" aria-hidden="true"></canvas>
    <button
      id="orbit-core"
      type="button"
      class="orbit-core"
      aria-label="Orbit's core. Press Enter or Space to sound a note; the arrow keys move it around the field."
    ></button>
    <p id="orbit-hint" class="orbit-hint" aria-hidden="true">touch · click · drag</p>
  </div>
  <script>
    import { initOrbit } from "../scripts/orbit";
    initOrbit();
  </script>
</Layout>
